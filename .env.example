DATABASE_URL="postgresql://central_balancos:central_balancos@localhost:5432/central_balancos?schema=public"

# Chave da API de LLM usada pelo módulo de Extração Inteligente (RF02) — nunca commitar
# o valor real. Sem uso ainda: a extração de hoje é um mock (ver lib/mock-extraction.ts).
# Guardar em cofre/variáveis de ambiente do provedor de deploy, nunca no código (§6 do RFC).
# LLM_API_KEY=""

# Segredo compartilhado que protege /api/lgpd/exportacao e /api/lgpd/eliminacao (direitos
# do titular — LGPD Art. 18) até existir autenticação real (RNF02). Gerar um valor
# aleatório (ex.: `openssl rand -hex 32`) e nunca commitar o valor real. Sem esta
# variável configurada, as duas rotas ficam bloqueadas (fail-closed) — não abertas.
LGPD_ADMIN_TOKEN=""

# Prazo de retenção (em dias) usado por `pnpm purge:data` (lib/server/retention.ts) antes
# de apagar AuditLog/Extracao antigos — LGPD Art. 15/16 (guardar só pelo tempo necessário).
# Opcionais: sem configurar, usa os defaults abaixo.
# AUDIT_LOG_RETENTION_DAYS="730"
# EXTRACAO_RETENTION_DAYS="180"
