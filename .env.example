DATABASE_URL="postgresql://central_balancos:central_balancos@localhost:5432/central_balancos?schema=public"

# Chave da API de LLM para uma futura Extração Inteligente (RF02) — nunca commitar o valor real.
# Sem uso ainda: a extração de hoje é um leitor local de PDF, sem LLM (ver lib/extraction/).
# Guardar em cofre/variáveis de ambiente do provedor de deploy, nunca no código (§6 do RFC).
# LLM_API_KEY=""

# Segredo que assina os cookies de sessão (login) — obrigatório, mínimo 32 caracteres.
# Gere um valor aleatório (ex.: `openssl rand -hex 32`) e NUNCA commite o valor real. Sem ele,
# o app recusa todo acesso (fail-closed) — o valor de exemplo abaixo é curto DE PROPÓSITO
# para não ser aceito. Trocá-lo derruba todas as sessões abertas E invalida o que foi protegido com ele:
# as chaves do app autenticador (2FA) e os códigos de recuperação. Depois de trocar, um administrador precisa
# desligar o 2FA de quem usava o app (tela Usuários) para a pessoa cadastrar de novo.
AUTH_SECRET=troque-me

# URL pública do app — usada nos links enviados por e-mail (recuperação de senha) e no
# redirecionamento do login com Google (precisa ser idêntica à cadastrada no console do Google).
# Em PRODUÇÃO é OBRIGATÓRIA (sem ela a recuperação de senha fica desligada, para o link nunca ser
# montado com o cabeçalho Host, que o cliente controla) e deve usar https.
APP_URL=http://localhost:3000

# Envio de e-mail (SMTP) — usado pela recuperação de senha ("Esqueci minha senha") e pelo código
# da verificação em 2 etapas. Funciona com qualquer provedor (Gmail com "senha de app", Resend,
# Mailtrap...). Sem SMTP_HOST e SMTP_FROM: em DESENVOLVIMENTO o e-mail aparece no console do
# servidor (dá para testar tudo); em PRODUÇÃO esses recursos ficam desligados — nunca finge enviar.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587            # 465 usa TLS direto; as demais sobem para TLS via STARTTLS
# SMTP_SECURE=            # opcional: true força TLS direto, false força STARTTLS (padrão: true só na porta 465)
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Central de Balanços <nao-responda@exemplo.com>"

# Login com Google (opcional). Sem os dois valores, o botão "Entrar com Google" não aparece.
# Crie um "ID do cliente OAuth" (aplicativo da Web) em console.cloud.google.com/apis/credentials
# com a URI de redirecionamento: <APP_URL>/api/auth/google/callback
# Só entra quem já foi cadastrado por um administrador (não há auto-cadastro).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Primeiro administrador, criado/atualizado por `npx prisma db seed`. O seed NÃO tem senha
# padrão: defina a sua (mínimo 10 caracteres) aqui e troque-a depois em "Senha", no rodapé da barra lateral.
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Administrador

# Prazo de retenção (em dias) usado por `pnpm purge:data` (lib/server/data/retention.ts) antes
# de apagar AuditLog/Extracao antigos — LGPD Art. 15/16 (guardar só pelo tempo necessário).
# Opcionais: sem configurar, usa os defaults abaixo.
# AUDIT_LOG_RETENTION_DAYS="730"
# EXTRACAO_RETENTION_DAYS="180"

# Chave dos selos de integridade da trilha de auditoria (mín. 32 caracteres). Se ficar em branco, usa o
# AUTH_SECRET. Definir uma própria evita que trocar o AUTH_SECRET (que derruba as sessões) faça a
# verificação acusar problema em todos os registros antigos. NÃO troque depois de gerar selos.
# AUDIT_SEAL_SECRET=""
